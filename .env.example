# ============================================================
# SignAI Pro Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or real secrets to GitHub.
# ============================================================

# Django Core Settings
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# Production Database (Optional: Neon PostgreSQL, Supabase, Railway)
# If omitted or left blank, Django automatically uses local SQLite (db.sqlite3)
DATABASE_URL=

# Google Gemini API Key (Optional: for generative summaries & quiz generation)
# If omitted, system falls back to deterministic offline NLP
GEMINI_API_KEY=

# Hugging Face Access Token (Optional: for private models)
HF_TOKEN=
